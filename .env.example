# Privatemode Auth Proxy Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Admin password for the web UI
# Generate a secure password, e.g.: openssl rand -base64 32
ADMIN_PASSWORD=your-secure-admin-password-here

# REQUIRED: Your Privatemode API key (get from privatemode.ai)
PRIVATEMODE_API_KEY=your-privatemode-api-key-here

# REQUIRED: Salt (at least 16 characters) used to protect newly generated keys
# while they are shown once in the admin UI. The app will not start without it.
# Generate with: openssl rand -base64 24
PBKDF2_SALT=replace-with-random-salt-at-least-16-chars

# OPTIONAL: Quick API keys via environment (comma-separated)
# These are in addition to any keys in the JSON file
# API_KEYS=key1,key2,key3

# OPTIONAL: Rate limiting defaults
# RATE_LIMIT_REQUESTS=100        # ceiling across all keys combined, per window
# RATE_LIMIT_WINDOW=60
# KEY_RATE_LIMIT_REQUESTS=60     # per key, for keys without their own limit
# IP_RATE_LIMIT_REQUESTS=1000
# IP_RATE_LIMIT_WINDOW=60

# OPTIONAL: Reverse proxy trust. Only enable when ALL traffic reaches the app
# through your own reverse proxy / load balancer (never when the app is
# reachable directly). TRUSTED_PROXY_HOPS = number of proxies in front.
# TRUST_PROXY=false
# TRUSTED_PROXY_HOPS=1

# OPTIONAL: Days to keep daily usage totals (no content is ever stored)
# USAGE_RETENTION_DAYS=400

# OPTIONAL: TLS configuration (for HTTPS)
# TLS_CERT_FILE=/app/certs/cert.pem
# TLS_KEY_FILE=/app/certs/key.pem
